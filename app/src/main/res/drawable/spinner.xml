            android:viewportHeight="6">
            <path
                android:fillColor="#00000000"
                android:pathData="M1,1L4.5,5L8,1"
                android:strokeWidth="2"
                android:strokeColor="#334155"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </vector>
    </item>
</layer-list>