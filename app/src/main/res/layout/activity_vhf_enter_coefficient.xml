<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_300"
    android:fitsSystemWindows="true"
    tools:context=".VHF.EnterCoefficientActivity">

    <include
        android:id="@+id/include_toolbar"
        layout="@layout/include_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="24sp"
        android:background="@color/catskill_white"
        android:elevation="4sp"
        android:orientation="vertical"
        android:paddingVertical="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_toolbar"
        tools:ignore="NestedWeights">

        <TextView
            android:id="@+id/tv_coefficient"
            style="@style/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:layout_marginTop="16sp"
            android:layout_marginBottom="8sp"
            android:gravity="center"
            android:textColor="@color/slate_gray" />

        <View
            android:id="@+id/v_line_frequency"
            android:layout_width="match_parent"
            android:layout_height="1sp"
            android:layout_marginHorizontal="16sp"
            android:background="@color/ghost"
            tools:ignore="SmallSp" />

        <include
            layout="@layout/include_coefficients_number"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_save_coefficient"
        style="@style/button_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginVertical="24sp"
        android:alpha="0.6"
        android:enabled="false"
        android:text="@string/lb_save"
        app:layout_constraintBottom_toTopOf="@id/include_vhf_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <include
        android:id="@+id/include_vhf_status"
        layout="@layout/include_vhf_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>