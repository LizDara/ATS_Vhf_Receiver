<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_300"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".VHF.TablesActivity">

    <include
        layout="@layout/ats_toolbar"/>
    
    <LinearLayout
        android:id="@+id/removed_frequencies_linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="24sp"
        android:background="@color/catskill_white"
        android:elevation="4sp"
        android:orientation="vertical"
        android:padding="16sp"
        android:visibility="gone">

        <TextView
            style="@style/body_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4sp"
            android:drawablePadding="8sp"
            android:text="@string/lb_removed_frequencies"
            android:textColor="@color/tall_poppy"
            app:drawableStartCompat="@drawable/ic_alert" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tall_poppy"
            style="@style/body_x_small"
            android:text="@string/lb_removed_frequencies_message"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginTop="24sp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_tables_textView"
            style="@style/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/load_from_file_button"
            style="@style/button_tertiary_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16sp"
            android:text="@string/lb_load_table_from_file" />

    </LinearLayout>

    <ListView
        android:id="@+id/tables_listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16sp"
        android:dividerHeight="16sp"
        android:divider="@color/transparent"/>

    <LinearLayout
        android:id="@+id/options_loaded_linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/body_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16sp"
            android:text="@string/lb_note_push"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/push_frequencies_button"
            style="@style/button_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:text="@string/lb_push_frequencies" />

    </LinearLayout>

    <include
        layout="@layout/receiver_status"/>

</LinearLayout>