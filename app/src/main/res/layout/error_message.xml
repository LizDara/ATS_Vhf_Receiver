<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16sp"
    android:background="@color/slate_50"
    android:elevation="@dimen/elevation_button"
    android:orientation="vertical"
    android:padding="16sp">

    <ImageButton
        android:id="@+id/close_upload_imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_close"
        tools:ignore="ContentDescription" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="16sp"
        android:background="@drawable/ic_error_alert"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/title_alert_textView"
        style="@style/body_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@color/slate_700" />

    <TextView
        android:id="@+id/message_alert_textView"
        style="@style/body_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="8sp"
        android:layout_marginBottom="16sp"
        android:textColor="@color/slate_700" />

    <LinearLayout
        android:id="@+id/options_alert_linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="8sp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/return_upload_textView"
            style="@style/button_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24sp"
            android:text="@string/lb_return_upload"
            android:textColor="@color/slate_700" />

        <Button
            android:id="@+id/cancel_upload_button"
            style="@style/button_primary_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_stop"
            android:text="@string/lb_cancel_upload" />

    </LinearLayout>

</LinearLayout>