<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16sp"
    android:layout_marginVertical="24sp"
    android:background="@color/catskill_white"
    android:elevation="4sp"
    android:orientation="vertical"
    android:padding="16sp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8sp">

        <ProgressBar
            android:layout_width="@dimen/line_height"
            android:layout_height="@dimen/line_height"
            android:layout_marginEnd="8sp" />

        <TextView
            style="@style/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ebony_clay"
            android:text="@string/lb_converting_raw_file" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_converting_raw"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_height"
        android:layout_marginBottom="48sp"
        android:progressDrawable="@drawable/progress_bar" />

    <Button
        android:id="@+id/btn_cancel_conversion"
        style="@style/button_tertiary_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8sp"
        android:text="@string/lb_cancel_conversion" />

</LinearLayout>