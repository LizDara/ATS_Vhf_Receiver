<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16sp"
    android:layout_marginVertical="24sp"
    android:background="@color/catskill_white"
    android:elevation="4sp"
    android:orientation="vertical"
    android:padding="16sp">

    <include
        android:id="@+id/include_downloading_process"
        layout="@layout/include_downloading_process" />

    <Button
        android:id="@+id/btn_cancel_download"
        style="@style/button_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32sp"
        android:text="@string/btn_vhf_data_cancel_download" />

</LinearLayout>