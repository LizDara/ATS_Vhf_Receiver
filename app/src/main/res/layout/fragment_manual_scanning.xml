<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8sp"
    android:orientation="vertical">

    <include
        android:id="@+id/include_gps_record_options"
        layout="@layout/include_gps_record_options"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="16sp"
        android:background="@color/catskill_white"
        android:elevation="4sp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16sp">

            <TextView
                style="@style/body_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8sp"
                android:text="@string/lbl_vhf_mobile_frequency"
                android:textColor="@color/limed_spruce" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_minus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_decrease"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_frequency_scan_manual"
                    style="@style/body_large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16sp"
                    android:textColor="@color/ebony_clay"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/img_plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ic_increase"
                    tools:ignore="ContentDescription" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_edit_frequency"
                    style="@style/button_tertiary_small"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/button_small_height"
                    android:paddingHorizontal="10sp"
                    android:text="@string/btn_vhf_manual_edit_frequency" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1sp"
            android:background="@color/light_gray"
            tools:ignore="SmallSp" />

        <include
            android:id="@+id/include_audio_option"
            layout="@layout/include_audio_option"/>

        <include
            android:id="@+id/include_coordinates"
            layout="@layout/include_coordinates"/>

        <include
            android:id="@+id/include_scan_details"
            layout="@layout/include_scan_details"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_view_detection_manual"
        style="@style/button_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4sp"
        android:layout_marginStart="16sp"
        android:text="@string/btn_vhf_mobile_view_detection_filter"
        android:textColor="@color/ebony_clay" />

</LinearLayout>