<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8sp"
    android:orientation="vertical">

    <include
        android:id="@+id/include_scan_options"
        layout="@layout/include_scan_options"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16sp"
        android:layout_marginBottom="16sp"
        android:background="@color/catskill_white"
        android:elevation="4sp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/body_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16sp"
                    android:text="@string/lbl_vhf_mobile_frequency"
                    android:textColor="@color/limed_spruce" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16sp"
                    android:paddingBottom="16sp">

                    <ImageView
                        android:id="@+id/img_minus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_decrease"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_frequency_scan_manual"
                        style="@style/body_large"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16sp"
                        android:textColor="@color/ebony_clay"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/img_plus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_increase"
                        tools:ignore="ContentDescription" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_edit_frequency"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_margin="16sp"
                android:background="@drawable/scan_option"
                android:drawablePadding="8sp"
                android:gravity="center"
                android:paddingHorizontal="10sp"
                android:paddingVertical="12sp"
                android:text="@string/btn_vhf_manual_edit_frequency"
                android:textColor="@color/black"
                app:drawableTopCompat="@drawable/ic_edit_frequency" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1sp"
            android:background="@color/light_gray"
            tools:ignore="SmallSp" />

        <include
            android:id="@+id/include_audio_option"
            layout="@layout/include_audio_option"/>

        <include
            android:id="@+id/include_coordinates"
            layout="@layout/include_coordinates"/>

        <include
            android:id="@+id/include_scan_details"
            layout="@layout/include_scan_details"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_view_detection_manual"
        style="@style/button_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4sp"
        android:layout_marginStart="16sp"
        android:text="@string/btn_vhf_mobile_view_detection_filter"
        android:textColor="@color/ebony_clay" />

</LinearLayout>