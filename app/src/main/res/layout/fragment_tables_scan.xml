<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_option_tables"
        style="@style/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24sp"
        android:layout_marginStart="16sp"
        android:text="@string/lb_select_table_merge"
        android:textColor="@color/black" />

    <include
        layout="@layout/include_list_view" />

    <Button
        android:id="@+id/btn_merge_tables"
        style="@style/button_primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16sp"
        android:layout_marginEnd="16sp"
        android:layout_marginBottom="24sp"
        android:alpha="0.6"
        android:enabled="false"
        android:text="@string/lb_merge_tables" />

</LinearLayout>