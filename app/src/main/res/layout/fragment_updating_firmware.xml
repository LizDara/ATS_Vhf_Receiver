<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16sp"
    android:layout_marginVertical="24sp"
    android:background="@color/slate_50"
    android:orientation="vertical"
    android:padding="16sp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8sp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/pb_downloading_file"
            android:layout_width="@dimen/line_height"
            android:layout_height="@dimen/line_height" />

        <TextView
            android:id="@+id/tv_update_progress"
            style="@style/text_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8sp"
            android:textColor="@color/black" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_updating"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/line_height"
        android:progressDrawable="@drawable/progress_bar" />

    <TextView
        android:id="@+id/tv_updated_file"
        style="@style/body_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4sp"
        android:layout_marginBottom="16sp"
        android:textColor="@color/slate_900" />

    <include
        layout="@layout/include_downloading_process" />

    <Button
        android:id="@+id/btn_cancel_update"
        style="@style/button_tertiary_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24sp"
        android:paddingHorizontal="16sp"
        android:text="@string/lb_cancel_update" />

</LinearLayout>